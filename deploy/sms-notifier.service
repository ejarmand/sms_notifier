[Unit]
Description=SMS Notifier
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=sms-notifier
Group=sms-notifier
WorkingDirectory=/opt/sms-notifier/server
EnvironmentFile=-/etc/sms-notifier/server.conf
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=TWILIO_ACCOUNT_SID:/etc/sms-notifier/credentials/TWILIO_ACCOUNT_SID
LoadCredential=TWILIO_AUTH_TOKEN:/etc/sms-notifier/credentials/TWILIO_AUTH_TOKEN
LoadCredential=TWILIO_PHONE_NUMBER:/etc/sms-notifier/credentials/TWILIO_PHONE_NUMBER
LoadCredential=YOUR_PHONE_NUMBER:/etc/sms-notifier/credentials/YOUR_PHONE_NUMBER
ExecStart=/opt/sms-notifier/.venv/bin/gunicorn --config /opt/sms-notifier/server/gunicorn.conf.py sms_notifier:create_app()
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
